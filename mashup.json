{
  "id": "sigf/mc-in-gta-enhanced",
  "version": "0.1.0",
  "name": "Minecraft in GTA Enhanced",
  "tagline": "Real Minecraft 26.3 inside GTA V Enhanced story mode: pick Steve on the character wheel and build, fight and blow things up in Los Santos.",
  "how_to_play": [
    "Real Minecraft 26.3 in GTA V Enhanced story mode: pick Steve and walk, build, fight and fly with Minecraft blocks, items and mobs in Los Santos.",
    "Press Play: Minecraft starts first and opens its own void creative world; leave its window open. GTA V Enhanced then starts: enter Story Mode.",
    "The mod stays off until you pick Steve (or press F7); GTA then shows \"Minecraft passthrough connected\".",
    "Hold Left Alt (controller D-pad Down) for the character wheel and choose Steve; pick a GTA character to leave Steve mode.",
    "F7 toggles Steve mode, F8 re-levels the ground, E creative inventory, 1-9 or mouse wheel hotbar, double-tap Space for the elytra, F9 a gun mode."
  ],
  "kind": "passthrough",
  "games": [
    {
      "game": "gta5",
      "role": "host",
      "label": "GTA V Enhanced",
      "engine": "GTA V Enhanced (RAGE, story mode) + ScriptHookV ASI MCPassthrough (C++) + ReShade add-on",
      "apps": {
        "steam": "3240220"
      },
      "builds": {
        "steam": [
          "1.0.1158.16"
        ]
      },
      "runtime": "GTA V Enhanced (GTA5_Enhanced.exe), loaded upstream on 1.0.1158.16; Legacy is not supported"
    },
    {
      "game": "minecraft",
      "role": "guest",
      "label": "Minecraft",
      "engine": "Minecraft Java 26.3 + Fabric mod passthrough (Java)",
      "mc": "26.3",
      "loader": "fabric@0.19.5",
      "java": "25"
    }
  ],
  "requires": [
    {
      "id": "scripthookv",
      "page": "https://www.dev-c.com/gtav/scripthookv/",
      "license": "Alexander Blade: free, not redistributable",
      "note": "Script Hook V for your GTA V Enhanced build: copy ScriptHookV.dll, dinput8.dll and xinput1_4.dll from its download into the GTA V Enhanced folder"
    },
    {
      "id": "reshade",
      "version": "6.8.0 (add-on)",
      "license": "BSD-3-Clause, shipped unchanged",
      "page": "https://reshade.me/",
      "note": "installed into the GTA V folder by the app as ReShade64.asi",
